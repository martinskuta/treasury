# Copy to .env (next to docker-compose.yaml) and fill in the two passwords.

# Treasury image published from main. Pin a commit instead of `latest` with ghcr.io/martinskuta/treasury:<commit sha>.
API_IMAGE=ghcr.io/martinskuta/treasury:latest

# Port the API listens on inside the container. Leave as is.
API_PORT=8080

# First Admin, created on the first start while there are no Members yet; ignored afterwards.
# Password rules: upper- and lower-case letter, digit, symbol, at least 6 characters.
# Change it in the app right after the first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Password of the `postgres` database user. Pick a long random one; you never type it in the app.
# It is only applied when the database volume is first created.
POSTGRES_PASSWORD=

# Optional: host port of the app (default 8080).
#TREASURY_HTTP_PORT=8080

# Optional: host folder for Ingest folders and Source files (default ./data next to docker-compose.yaml).
# On Linux it must be writable by uid 1654.
#TREASURY_DATA_DIR=./data
